# gs-server configuration. Every variable is optional; defaults shown.
# `pnpm dev` and `pnpm stack` set the database/redis URLs for you.

# HTTP: web client, REST API, and the one-time WebRTC signaling POST.
GS_HTTP_ADDR=0.0.0.0:8080
# The single UDP port all WebRTC game traffic uses.
GS_UDP_PORT=40000
# LAN address advertised to browsers in the ICE candidate. Auto-detected when unset.
# Set it explicitly when running in Docker (pnpm stack does).
GS_PUBLIC_IP=
# Dragonfly (Redis protocol). Unset = in-memory store (rooms don't survive restarts).
GS_REDIS_URL=redis://127.0.0.1:6379
# Postgres. Unset = no match history / leaderboard.
DATABASE_URL=postgres://gs:gs@127.0.0.1:5432/gs
# Serve a built web client from this directory (production / Docker).
GS_WEB_DIR=
# How long a disconnected player's seat is held for them to resume.
GS_RESUME_GRACE_SECS=30
# Rooms with no connections checkpoint and stop after this long (they resume on next join).
GS_ROOM_IDLE_SECS=120
# Full room checkpoint to Dragonfly every N ticks (the tick log covers the gap).
GS_CHECKPOINT_EVERY=300
# Log filter.
RUST_LOG=info,str0m=warn,dimpl=warn
